{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tess-prf-recovery-calibration-1.0.json",
  "title": "Candidate-local TESS PRF recovery calibration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "mission", "prf_sha256", "recovery_passed", "recovery_results", "source_artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "mission": {"const": "TESS"},
    "prf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recovery_passed": {"const": true},
    "recovery_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["injected_flux", "recovered_flux"], "properties": {"injected_flux": {"type": "number", "exclusiveMinimum": 0}, "recovered_flux": {"type": "number", "minimum": 0}}}},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "role": {"type": "string", "minLength": 1}}}}
}
