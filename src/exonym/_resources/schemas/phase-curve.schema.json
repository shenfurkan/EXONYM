{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/phase-curve-1.1.json",
  "title": "Candidate-local Phase-curve Diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_package", "generated_utc", "source", "method", "status", "period_days", "epoch_btjd", "n_points_after_primary_transit_mask", "n_sectors", "n_covariance_clusters", "primary_mask_half_width_hours", "secondary_box_duration_hours", "components", "maximum_absolute_significance_sigma", "interpretation"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "work_package": {"const": "PHASE_CURVE"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "source": {"const": "candidate-data"},
    "scientific_status": {"const": "exploratory-phase-curve-diagnostic"},
    "validation_eligible": {"const": false},
    "validation_reason": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "status": {"enum": ["unphysical_phase_harmonic_detected_systematics_limited", "no_significant_phase_curve_component", "component_above_three_sigma_requires_followup"]},
    "period_days": {"type": "number", "exclusiveMinimum": 0},
    "epoch_btjd": {"type": "number"},
    "n_points_after_primary_transit_mask": {"type": "integer", "minimum": 100},
    "n_sectors": {"type": "integer", "minimum": 1},
    "n_covariance_clusters": {"type": "integer", "minimum": 1},
    "primary_mask_half_width_hours": {"type": "number", "exclusiveMinimum": 0},
    "secondary_eclipse_control": {"$ref": "#/$defs/secondary_eclipse_control"},
    "secondary_box_phase": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
    "secondary_box_duration_hours": {"type": "number", "exclusiveMinimum": 0},
    "secondary_box_template_method": {"enum": ["fixed-secondary-box", "posterior-marginalized-eccentric-box"]},
    "components": {"$ref": "#/$defs/components"},
    "maximum_absolute_significance_sigma": {"type": "number", "minimum": 0},
    "interpretation": {"type": "string", "minLength": 1}
  },
  "anyOf": [
    {
      "properties": {"schema_version": {"const": "1.0"}}
    },
    {
      "properties": {"schema_version": {"const": "1.1"}},
      "required": ["scientific_status", "validation_eligible", "validation_reason", "secondary_eclipse_control", "secondary_box_phase", "secondary_box_template_method"]
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "phase_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p16", "p84", "credible_interval_wraps_phase_zero", "half_width_phase"],
      "properties": {
        "median": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "p16": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "p84": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "credible_interval_wraps_phase_zero": {"type": "boolean"},
        "half_width_phase": {"type": "number", "minimum": 0, "maximum": 0.5}
      }
    },
    "duration_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median", "p16", "p84"],
      "properties": {
        "median": {"type": "number", "exclusiveMinimum": 0},
        "p16": {"type": "number", "exclusiveMinimum": 0},
        "p84": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "circular_transit_fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "outputs/mcmc_transit_fit.json"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "eccentric_transit_fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "chain_path", "chain_sha256"],
      "properties": {
        "path": {"const": "outputs/mcmc_transit_fit.json"},
        "sha256": {"$ref": "#/$defs/digest"},
        "chain_path": {"const": "outputs/mcmc_transit_fit_chain.npy"},
        "chain_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "secondary_eclipse_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "phase", "duration_hours", "caveat"],
      "properties": {
        "mode": {"enum": ["circular-ephemeris-box-control", "eccentric-posterior-marginalized-box-control"]},
        "phase": {"$ref": "#/$defs/phase_summary"},
        "duration_hours": {"$ref": "#/$defs/duration_summary"},
        "occultation_probability_from_sampled_posterior": {"type": "number", "minimum": 0, "maximum": 1},
        "posterior_template_samples": {"type": "integer", "minimum": 1, "maximum": 512},
        "transit_fit": {"$ref": "#/$defs/eccentric_transit_fit"},
        "geometry": {"type": "string", "minLength": 1},
        "caveat": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "circular-ephemeris-box-control"}}},
          "then": {
            "properties": {
              "transit_fit": {"$ref": "#/$defs/circular_transit_fit"}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "eccentric-posterior-marginalized-box-control"}}},
          "then": {
            "required": ["occultation_probability_from_sampled_posterior", "posterior_template_samples", "transit_fit", "geometry"]
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_ppm", "block_robust_error_ppm", "significance_sigma", "three_sigma_absolute_upper_bound_ppm"],
      "properties": {
        "value_ppm": {"type": "number"},
        "block_robust_error_ppm": {"type": "number", "minimum": 0},
        "significance_sigma": {"type": "number"},
        "three_sigma_absolute_upper_bound_ppm": {"type": "number", "minimum": 0}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reflection_semiamplitude", "beaming_semiamplitude", "ellipsoidal_semiamplitude", "second_harmonic_sine_control", "secondary_eclipse_depth"],
      "properties": {
        "reflection_semiamplitude": {"$ref": "#/$defs/component"},
        "beaming_semiamplitude": {"$ref": "#/$defs/component"},
        "ellipsoidal_semiamplitude": {"$ref": "#/$defs/component"},
        "second_harmonic_sine_control": {"$ref": "#/$defs/component"},
        "secondary_eclipse_depth": {"$ref": "#/$defs/component"}
      }
    }
  }
}
