{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/known-signal-ephemeris-match-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "generated_at", "source", "signal", "method", "status", "candidate_ephemeris", "configuration", "source_snapshots", "excluded_retrievals", "comparisons", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"const": "candidate-data"},
    "signal": {"type": ["string", "null"], "pattern": "^\\.[0-9]{2}$"},
    "method": {"enum": ["nea-pscomppars-period-epoch-duration-harmonic-v1", "known-signal-ephemeris-period-epoch-duration-harmonic-v2", "known-signal-ephemeris-period-epoch-duration-harmonic-v3", "known-signal-ephemeris-period-epoch-duration-harmonic-v4", "known-signal-ephemeris-period-epoch-duration-harmonic-v5", "known-signal-ephemeris-period-epoch-duration-harmonic-v6"]},
    "status": {"enum": ["review-required-known-signal-match", "review-required-period-harmonic", "review-required-period-tolerance-unavailable", "no-ephemeris-match-in-current-supported-catalog", "insufficient-current-supported-catalog-evidence"]},
    "candidate_ephemeris": {"$ref": "#/$defs/candidate_ephemeris"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "source_snapshots": {"type": "array", "items": {"$ref": "#/$defs/source_snapshot"}},
    "excluded_retrievals": {"type": "array", "items": {"$ref": "#/$defs/excluded_retrieval"}},
    "comparisons": {"type": "array", "items": {"$ref": "#/$defs/comparison"}},
    "limitations": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"method": {"const": "known-signal-ephemeris-period-epoch-duration-harmonic-v4"}}},
      "then": {"properties": {"comparisons": {"items": {"required": ["harmonic_parity_ambiguous"]}}}}
    },
    {
      "if": {"properties": {"method": {"const": "known-signal-ephemeris-period-epoch-duration-harmonic-v6"}}},
      "then": {"properties": {"candidate_ephemeris": {"required": ["period_uncertainty_days"]}, "configuration": {"required": ["period_comparison_method"]}, "comparisons": {"items": {"required": ["harmonic_parity_ambiguous", "known_period_uncertainty_days", "candidate_period_uncertainty_days", "period_difference_days", "period_tolerance_days", "period_tolerance_status"], "properties": {"nearest_harmonic_factor": {"enum": [0.5, 0.6667, 0.75, 0.8, 1.0, 1.25, 1.3333, 1.5, 2.0]}}}}}}
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?:config/(?:signals/)?|outputs/|runs/catalog/|decisions/)[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "candidate_ephemeris": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "signal", "period_days", "epoch_btjd", "duration_hours", "time_system", "input_artifact"],
      "properties": {
        "source": {"enum": ["candidate-config", "partial-candidate-config", "candidate-config-signal", "partial-candidate-config-signal", "bls-search"]},
        "signal": {"type": ["string", "null"], "pattern": "^\\.[0-9]{2}$"},
        "period_days": {"type": "number", "exclusiveMinimum": 0},
        "period_uncertainty_days": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "epoch_btjd": {"type": "number"},
        "duration_hours": {"type": "number", "exclusiveMinimum": 0},
        "time_system": {"const": "BTJD_TDB"},
        "input_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
       "required": ["supported_providers", "epoch_tolerance_duration_multiplier", "duration_relative_tolerance", "harmonic_factors"],
      "properties": {
        "supported_providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["nasa-exoplanet-archive", "nasa-exoplanet-archive-toi", "candidate-recorded-evidence"]}},
        "period_relative_tolerance": {"const": 0.001},
        "period_comparison_method": {"const": "reported-period-uncertainty-quadrature-v1"},
        "epoch_tolerance_duration_multiplier": {"const": 1.0},
        "duration_relative_tolerance": {"const": 0.5},
        "harmonic_factors": {"enum": [[0.3333, 0.5, 0.6667, 0.75, 0.8, 1.0, 1.25, 1.3333, 1.5, 2.0, 3.0], [0.5, 0.6667, 0.75, 0.8, 1.0, 1.25, 1.3333, 1.5, 2.0]]}
      }
    },
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "retrieval_id", "query_manifest", "snapshot", "native_time_scale"],
      "properties": {
        "provider": {"enum": ["nasa-exoplanet-archive", "nasa-exoplanet-archive-toi", "candidate-recorded-evidence"]},
        "retrieval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "query_manifest": {"$ref": "#/$defs/artifact"},
        "snapshot": {"$ref": "#/$defs/artifact"},
        "native_time_scale": {"enum": ["BJD_TDB", "BJD_UNSPECIFIED", "PER_RECORD_DECLARED_TIME_SCALE"]}
      }
    },
    "excluded_retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?:runs/catalog/[A-Za-z0-9._/-]+\\.json|decisions/known_signal_ephemerides\\.json)$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "retrieval_id", "snapshot_path", "snapshot_sha256", "source_record_index", "source_name", "known_period_days", "known_epoch_bjd_tdb", "known_epoch_time_scale", "known_duration_hours", "period_ratio_known_over_candidate", "nearest_harmonic_factor", "period_relative_difference", "period_harmonic_match", "epoch_phase_delta_days", "epoch_tolerance_days", "epoch_match", "duration_ratio_known_over_candidate", "duration_compatible", "review_required"],
      "properties": {
        "provider": {"enum": ["nasa-exoplanet-archive", "nasa-exoplanet-archive-toi", "candidate-recorded-evidence"]},
        "retrieval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "snapshot_path": {"type": "string", "pattern": "^(?:runs/catalog/nasa-exoplanet-archive(?:-toi)?/[A-Za-z0-9._-]+/snapshot\\.json|decisions/known_signal_ephemerides\\.json)$"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_record_index": {"type": "integer", "minimum": 0},
        "source_name": {"type": ["string", "null"]},
        "known_period_days": {"type": "number", "exclusiveMinimum": 0},
        "known_period_uncertainty_days": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "known_epoch_bjd_tdb": {"type": ["number", "null"]},
        "known_epoch_time_scale": {"enum": ["BJD_TDB", "BJD_UNSPECIFIED"]},
        "known_duration_hours": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "period_ratio_known_over_candidate": {"type": "number", "exclusiveMinimum": 0},
        "nearest_harmonic_factor": {"enum": [0.3333, 0.5, 0.6667, 0.75, 0.8, 1.0, 1.25, 1.3333, 1.5, 2.0, 3.0]},
        "period_relative_difference": {"type": "number", "minimum": 0},
        "period_difference_days": {"type": "number", "minimum": 0},
        "candidate_period_uncertainty_days": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "period_tolerance_days": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "period_tolerance_status": {"enum": ["available", "unavailable"]},
        "period_harmonic_match": {"type": ["boolean", "null"]},
        "epoch_phase_delta_days": {"type": ["number", "null"], "minimum": 0},
        "epoch_tolerance_days": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "epoch_match": {"type": ["boolean", "null"]},
        "harmonic_parity_ambiguous": {"type": "boolean"},
        "duration_ratio_known_over_candidate": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "duration_compatible": {"type": ["boolean", "null"]},
        "review_required": {"type": "boolean"}
      }
    }
  }
}
