{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/automated-triage-1.0.json",
  "title": "Candidate-local Automated Triage Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "generated_at",
    "policy_id",
    "policy_version",
    "status",
    "records"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "policy_version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "review-required", "blocked"] },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine",
          "run_manifest_path",
          "run_manifest_sha256",
          "status",
          "reason"
        ],
        "properties": {
          "engine": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "run_manifest_path": {
            "type": "string",
            "pattern": "^runs/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]*/engine-run\\.json$"
          },
          "run_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": { "enum": ["pass", "review-required", "blocked"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
