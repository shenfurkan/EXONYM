{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/catalog-snapshot-1.0.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "provider", "retrieval_id", "status", "source_uri", "release", "query_template_id", "retrieved_at", "raw_response", "citation", "units_note", "native_time_scale", "records"],
  "properties": {"schema_version": {"const": 1}, "candidate_id": {"$ref": "#/$defs/id"}, "provider": {"$ref": "#/$defs/provider"}, "retrieval_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["available", "empty", "unavailable", "ambiguous", "requires-authentication"]}, "source_uri": {"type": "string", "format": "uri"}, "release": {"type": "string", "minLength": 1}, "query_template_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-v1$"}, "retrieved_at": {"type": "string", "format": "date-time"}, "raw_response": {"$ref": "#/$defs/artifact"}, "citation": {"type": "string", "minLength": 1}, "units_note": {"type": "string", "minLength": 1}, "native_time_scale": {"type": ["string", "null"]}, "normalization_policy": {"type": "string", "minLength": 1}, "records": {"type": "array", "items": {"type": "object"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "provider": {"enum": ["mast", "gaia", "simbad", "vizier", "nasa-exoplanet-archive", "nasa-exoplanet-archive-toi", "irsa", "ztf", "exofop", "lamost-dr11", "smoka", "mast-hubble-jwst"]}, "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "role": {"type": "string", "minLength": 1}}}}
}
