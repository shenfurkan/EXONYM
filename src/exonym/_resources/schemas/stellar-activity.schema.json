{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/stellar-activity-1.0.json",
  "title": "Candidate-local Stellar Activity Diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_package", "generated_utc", "source", "method", "period_search_range_days", "rotation_period_days", "rotation_period_std_days", "modulation_amplitude_ppm", "n_segments", "segments", "caveat"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_package": {"const": "STELLAR_ACTIVITY"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "source": {"const": "candidate-data"},
    "scientific_status": {"const": "exploratory-activity-diagnostic"},
    "validation_eligible": {"const": false},
    "transit_mask_status": {"enum": ["applied-candidate-ephemeris", "not-applied-no-candidate-ephemeris", "not-applied-insufficient-post-mask-cadences"]},
    "method": {"type": "string", "minLength": 1},
    "period_search_range_days": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
    "rotation_period_days": {"type": "number", "exclusiveMinimum": 0},
    "rotation_period_std_days": {"type": "number", "minimum": 0},
    "modulation_amplitude_ppm": {"type": "number", "minimum": 0},
    "best_false_alarm_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "best_analytic_white_noise_false_alarm_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "n_segments": {"type": "integer", "minimum": 1},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
    "harmonic_persistence": {"$ref": "#/$defs/harmonic_persistence"},
    "caveat": {"type": "string", "minLength": 1}
  },
  "anyOf": [
    {"required": ["best_false_alarm_probability"]},
    {"required": ["best_analytic_white_noise_false_alarm_probability", "scientific_status", "harmonic_persistence", "validation_eligible", "transit_mask_status"]}
  ],
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector", "n_points", "baseline_days", "best_period_days", "max_power"],
      "properties": {
        "sector": {"type": "integer", "minimum": 1},
        "n_points": {"type": "integer", "minimum": 1},
        "baseline_days": {"type": "number", "exclusiveMinimum": 0},
        "best_period_days": {"type": "number", "exclusiveMinimum": 0},
        "max_power": {"type": "number", "minimum": 0},
        "false_alarm_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "analytic_white_noise_false_alarm_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "sampling_window": {"$ref": "#/$defs/sampling_window"}
      },
      "anyOf": [
        {"required": ["false_alarm_probability"]},
        {"required": ["analytic_white_noise_false_alarm_probability", "sampling_window"]}
      ]
    },
    "sampling_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "baseline_days", "frequency_resolution_days_inverse", "top_window_peaks", "nearest_window_peak", "direct_frequency_proximity_within_resolution", "interpretation"],
      "properties": {
        "method": {"const": "normalized-spectral-window-v1"},
        "baseline_days": {"type": "number", "exclusiveMinimum": 0},
        "frequency_resolution_days_inverse": {"type": "number", "exclusiveMinimum": 0},
        "top_window_peaks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/window_peak"}},
        "nearest_window_peak": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nearest_window_peak"}]},
        "direct_frequency_proximity_within_resolution": {"type": ["boolean", "null"]},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "window_peak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency_days_inverse", "period_days", "window_power"],
      "properties": {
        "frequency_days_inverse": {"type": "number", "exclusiveMinimum": 0},
        "period_days": {"type": "number", "exclusiveMinimum": 0},
        "window_power": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "nearest_window_peak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency_days_inverse", "period_days", "window_power", "frequency_difference_days_inverse"],
      "properties": {
        "frequency_days_inverse": {"type": "number", "exclusiveMinimum": 0},
        "period_days": {"type": "number", "exclusiveMinimum": 0},
        "window_power": {"type": "number", "minimum": 0, "maximum": 1},
        "frequency_difference_days_inverse": {"type": "number", "minimum": 0}
      }
    },
    "harmonic_persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference_frequency_days_inverse", "reference_period_days", "segments", "consistent_segment_count", "interpretation"],
      "properties": {
        "status": {"enum": ["unresolved-insufficient-segments", "descriptive-harmonic-consistency"]},
        "reference_frequency_days_inverse": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "reference_period_days": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/harmonic_segment"}},
        "consistent_segment_count": {"type": "integer", "minimum": 0},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "harmonic_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector", "best_period_days", "best_frequency_days_inverse", "nearest_harmonic_frequency_factor", "frequency_residual_days_inverse", "frequency_resolution_days_inverse", "compatible_with_reference_or_first_harmonic"],
      "properties": {
        "sector": {"type": "integer", "minimum": 1},
        "best_period_days": {"type": "number", "exclusiveMinimum": 0},
        "best_frequency_days_inverse": {"type": "number", "exclusiveMinimum": 0},
        "nearest_harmonic_frequency_factor": {"enum": [0.5, 1.0, 2.0]},
        "frequency_residual_days_inverse": {"type": "number", "minimum": 0},
        "frequency_resolution_days_inverse": {"type": "number", "exclusiveMinimum": 0},
        "compatible_with_reference_or_first_harmonic": {"type": "boolean"}
      }
    }
  }
}
