{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/sed-fit-results-2.0.json",
  "title": "Candidate-local MIST v1.2 bolometric-correction SED diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "work_package", "generated_utc", "source", "scientific_status", "validation_eligible", "claim_eligible", "method", "input_provenance", "table_metadata", "fixed_atmosphere", "fit", "photometry", "caveats"],
  "properties": {
    "schema_version": {"const": 2},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "work_package": {"const": "SED_FIT"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "source": {"const": "candidate-data"},
    "scientific_status": {"const": "exploratory-mist-v1.2-bolometric-correction-diagnostic"},
    "validation_eligible": {"const": false},
    "claim_eligible": {"const": false},
    "method": {"const": "MIST v1.2 bolometric-correction table interpolation with profiled apparent bolometric magnitude and A_V"},
    "input_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_manifest_artifact", "input_artifacts"],
      "properties": {
        "input_manifest_artifact": {"$ref": "#/$defs/artifact"},
        "input_artifacts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "table_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "bc_table_release", "rv", "magnitude_system", "interpolation"],
      "properties": {
        "release": {"const": "MIST v1.2"},
        "bc_table_release": {"const": "BC_tables/v1"},
        "rv": {"type": "number", "exclusiveMinimum": 0},
        "magnitude_system": {"const": "Vega"},
        "interpolation": {"const": "multilinear-rectilinear-no-extrapolation"}
      }
    },
    "fixed_atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teff_k", "logg_cgs", "feh_dex"],
      "properties": {
        "teff_k": {"type": "number"},
        "logg_cgs": {"type": "number"},
        "feh_dex": {"type": "number"}
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["av_mag", "apparent_bolometric_mag", "chi_square", "degrees_of_freedom"],
      "properties": {
        "av_mag": {"type": "number"},
        "apparent_bolometric_mag": {"type": "number"},
        "chi_square": {"type": "number", "minimum": 0},
        "degrees_of_freedom": {"type": "integer", "minimum": 1}
      }
    },
    "photometry": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/photometry-row"}},
    "caveats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "photometry-row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "catalog_band", "mist_column", "observed_mag", "uncertainty_mag", "bc_mag_at_fit", "model_mag", "residual_mag"],
      "properties": {
        "catalog": {"type": "string", "minLength": 1},
        "catalog_band": {"type": "string", "minLength": 1},
        "mist_column": {"type": "string", "minLength": 1},
        "observed_mag": {"type": "number"},
        "uncertainty_mag": {"type": "number", "exclusiveMinimum": 0},
        "bc_mag_at_fit": {"type": "number"},
        "model_mag": {"type": "number"},
        "residual_mag": {"type": "number"}
      }
    }
  }
}
