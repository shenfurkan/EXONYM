{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/triceratops-vetting-decision-1.0.json",
  "title": "Candidate-local TRICERATOPS Vetting Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "generated_at", "signal",
    "execution_status", "triage_status", "result_status", "FPP", "NFPP",
    "blocking_reasons", "error", "input_artifacts", "triceratops_report",
    "audit_status", "audit_invalid_reason",
    "claim_eligible"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "signal": { "type": ["string", "null"], "pattern": "^\\.[0-9]{2}$" },
    "execution_status": { "enum": ["ready", "blocked", "succeeded", "failed", "unavailable"] },
    "triage_status": { "enum": ["pass", "review-required", "blocked", "not-run"] },
    "result_status": { "enum": ["unresolved", "review-required", "fpp-pass", "fpp-fail"] },
    "FPP": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "NFPP": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "blocking_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "triceratops_report": {
      "anyOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }]
    },
    "audit_status": { "enum": ["valid", "invalid"] },
    "audit_invalid_reason": { "type": ["string", "null"], "minLength": 1 },
    "claim_eligible": { "const": false }
  },
  "allOf": [
    {
      "if": { "properties": { "audit_status": { "const": "valid" } } },
      "then": {
        "properties": {
          "execution_status": { "const": "succeeded" },
          "FPP": { "type": "number", "minimum": 0, "maximum": 1 },
          "NFPP": { "type": "number", "minimum": 0, "maximum": 1 },
          "triceratops_report": { "$ref": "#/$defs/artifact" },
          "audit_invalid_reason": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "audit_status": { "const": "invalid" } } },
      "then": {
        "properties": {
          "FPP": { "type": "null" },
          "NFPP": { "type": "null" },
          "audit_invalid_reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
