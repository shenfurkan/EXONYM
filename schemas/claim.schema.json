{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Claim Assertion",
  "type": "object",
  "required": [
    "parameter",
    "value",
    "uncertainty_upper",
    "uncertainty_lower",
    "unit",
    "method"
  ],
  "properties": {
    "parameter": {
      "type": "string",
      "enum": ["period_days", "radius_earth", "mass_earth", "fpp"]
    },
    "value": { "type": "number" },
    "uncertainty_upper": { "type": ["number", "null"] },
    "uncertainty_lower": { "type": ["number", "null"] },
    "unit": { "type": "string" },
    "method": { "type": "string" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "report_path": { "type": "string", "minLength": 1 },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "parameter": { "const": "fpp" } } },
      "then": {
        "required": ["candidate_id", "report_path", "report_sha256"],
        "properties": {
          "value": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncertainty_upper": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "uncertainty_lower": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "unit": { "const": "dimensionless" }
        }
      }
    },
    {
      "if": { "properties": { "parameter": { "const": "period_days" } } },
      "then": {
        "properties": {
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "uncertainty_upper": { "type": ["number", "null"], "minimum": 0 },
          "uncertainty_lower": { "type": ["number", "null"], "minimum": 0 },
          "unit": { "const": "days" }
        }
      }
    },
    {
      "if": { "properties": { "parameter": { "const": "radius_earth" } } },
      "then": {
        "properties": {
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "uncertainty_upper": { "type": ["number", "null"], "minimum": 0 },
          "uncertainty_lower": { "type": ["number", "null"], "minimum": 0 },
          "unit": { "const": "R_earth" }
        }
      }
    },
    {
      "if": { "properties": { "parameter": { "const": "mass_earth" } } },
      "then": {
        "properties": {
          "value": { "type": "number", "exclusiveMinimum": 0 },
          "uncertainty_upper": { "type": ["number", "null"], "minimum": 0 },
          "uncertainty_lower": { "type": ["number", "null"], "minimum": 0 },
          "unit": { "const": "M_earth" }
        }
      }
    }
  ]
}
