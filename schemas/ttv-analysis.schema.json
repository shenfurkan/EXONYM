{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ttv-analysis-1.0.json",
  "title": "Candidate-local exploratory transit-timing analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "work_package", "generated_utc", "source", "signal", "ephemeris", "input_provenance", "timing", "companion_super_periods", "timing_diagram", "caveat"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "work_package": {"const": "TTV_ANALYSIS"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "source": {"const": "candidate-data"},
    "signal": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^\\.[0-9]{2}$"}]},
    "ephemeris": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period_days", "epoch_btjd", "source", "field_sources"],
      "properties": {
        "period_days": {"type": "number", "exclusiveMinimum": 0},
        "epoch_btjd": {"type": "number"},
        "source": {"type": "string", "minLength": 1},
        "field_sources": {"type": "object"}
      }
    },
    "input_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photometry_source", "photometry_files", "stellar_parameters_source", "transit_fit_artifact"],
      "properties": {
        "photometry_source": {"const": "candidate-data"},
        "photometry_files": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "stellar_parameters_source": {"const": "candidate-data"},
        "transit_fit_artifact": {"$ref": "#/$defs/transit-fit-artifact"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["template", "n_transits_fit", "epochs", "t_observed_btjd", "t_calculated_btjd", "oc_minutes", "oc_error_minutes", "linear_ephemeris", "quadratic_ephemeris", "ephemeris_model_requested", "ephemeris_model_used", "ephemeris_model_comparison"],
      "properties": {
        "template": {"$ref": "#/$defs/template"},
        "n_transits_fit": {"type": "integer", "minimum": 0},
        "epochs": {"type": "array", "items": {"type": "integer"}},
        "t_observed_btjd": {"type": "array", "items": {"type": "number"}},
        "t_calculated_btjd": {"type": "array", "items": {"type": "number"}},
        "oc_minutes": {"type": "array", "items": {"type": "number"}},
        "oc_error_minutes": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
        "linear_ephemeris": {"type": "object"},
        "quadratic_ephemeris": {"type": "object"},
        "ephemeris_model_requested": {"enum": ["linear", "quadratic"]},
        "ephemeris_model_used": {"type": "string", "minLength": 1},
        "ephemeris_model_comparison": {"type": "object"},
        "orbital_decay_fit": {"$ref": "#/$defs/orbital-decay-fit"}
      }
    },
    "companion_super_periods": {"type": "array", "items": {"type": "object"}},
    "timing_diagram": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
    "caveat": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "transit-fit-artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "work_package", "source", "signal", "scientific_status", "validation_eligible"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/digest"},
        "work_package": {"enum": ["MCMC_TRANSIT_FIT", "NESTED_TRANSIT_FIT"]},
        "source": {"const": "candidate-data"},
        "signal": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^\\.[0-9]{2}$"}]},
        "scientific_status": {"type": ["string", "null"]},
        "validation_eligible": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "artifact", "parameters", "model_assumptions", "limitations"],
      "properties": {
        "kind": {"const": "candidate-local-transit-fit-posterior-median"},
        "artifact": {"$ref": "#/$defs/transit-fit-artifact"},
        "parameters": {"type": "object"},
        "model_assumptions": {"type": "object"},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "orbital-decay-fit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "validation_eligible", "claim_eligible", "interpretation"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "validation_eligible": {"const": false},
        "claim_eligible": {"const": false},
        "interpretation": {"type": "string", "minLength": 1}
      }
    }
  }
}
