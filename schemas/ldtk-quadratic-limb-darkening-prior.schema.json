{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ldtk-quadratic-limb-darkening-prior-1.0.json",
  "title": "LDTk Quadratic Limb-Darkening Prior",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package",
    "generated_utc",
    "candidate_id",
    "method",
    "ldtk",
    "input_provenance",
    "stellar_parameters",
    "quadratic_coefficients"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "work_package": { "const": "LDTK_QUADRATIC_LIMB_DARKENING_PRIOR" },
    "generated_utc": { "type": "string", "format": "date-time" },
    "candidate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "method": { "type": "string", "minLength": 1 },
    "ldtk": {
      "type": "object",
      "required": ["version", "coefficient_method", "monte_carlo"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "coefficient_method": { "type": "string" },
        "monte_carlo": { "type": "boolean" }
      }
    },
    "input_provenance": {
      "type": "object",
      "required": ["stellar_parameters_path", "stellar_parameters_sha256"],
      "additionalProperties": false,
      "properties": {
        "stellar_parameters_path": { "type": "string", "minLength": 1 },
        "stellar_parameters_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "stellar_parameters": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "teff_k": { "$ref": "#/$defs/effective_temperature_k" }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["value", "uncertainty", "unit"],
        "additionalProperties": false,
        "properties": {
          "value": { "type": "number" },
          "uncertainty": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string" }
        }
      }
    },
    "quadratic_coefficients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filter", "u1", "u1_err", "u2", "u2_err", "unit"],
        "additionalProperties": false,
        "properties": {
          "filter": { "type": "string", "minLength": 1 },
          "u1": { "type": "number" },
          "u1_err": { "type": "number", "exclusiveMinimum": 0 },
          "u2": { "type": "number" },
          "u2_err": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "effective_temperature_k": {
      "type": "object",
      "required": ["value", "uncertainty", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "uncertainty": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "const": "K" }
      }
    }
  }
}
