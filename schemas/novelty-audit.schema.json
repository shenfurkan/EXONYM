{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/novelty-audit.json",
  "title": "Candidate Novelty Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "retrieved_at",
    "freshness",
    "status",
    "decision_basis",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at"],
      "properties": {
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["eligible", "ineligible", "inconclusive", "unavailable"]
    },
    "decision_basis": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_uri", "retrieved_at", "finding", "evidence_sha256"],
        "properties": {
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provider": {
            "type": "string",
            "enum": ["nasa-toi", "nasa-confirmed", "exofop"]
          },
          "response_path": {
            "type": "string",
            "pattern": "^data/external/novelty/[a-f0-9]{32}/[0-9]+-(nasa-toi|nasa-confirmed|exofop)\\.(csv|json)$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"provider": {"const": "nasa-toi"}},
              "required": ["provider"]
            },
            "then": {
              "properties": {
                "source_uri": {"pattern": "^https://exoplanetarchive\\.ipac\\.caltech\\.edu/TAP/sync\\?"},
                "response_path": {"pattern": "^data/external/novelty/[a-f0-9]{32}/[0-9]+-nasa-toi\\.csv$"}
              }
            }
          },
          {
            "if": {
              "properties": {"provider": {"const": "nasa-confirmed"}},
              "required": ["provider"]
            },
            "then": {
              "properties": {
                "source_uri": {"pattern": "^https://exoplanetarchive\\.ipac\\.caltech\\.edu/TAP/sync\\?"},
                "response_path": {"pattern": "^data/external/novelty/[a-f0-9]{32}/[0-9]+-nasa-confirmed\\.csv$"}
              }
            }
          },
          {
            "if": {
              "properties": {"provider": {"const": "exofop"}},
              "required": ["provider"]
            },
            "then": {
              "properties": {
                "source_uri": {"pattern": "^https://exofop\\.ipac\\.caltech\\.edu/tess/target\\.php\\?"},
                "response_path": {"pattern": "^data/external/novelty/[a-f0-9]{32}/[0-9]+-exofop\\.json$"}
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": 2}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "evidence": {
            "items": {
              "required": ["provider", "response_path"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": 2},
          "status": {"const": "eligible"}
        },
        "required": ["schema_version", "status"]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {"provider": {"const": "nasa-toi"}},
                  "required": ["provider"]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"provider": {"const": "nasa-confirmed"}},
                  "required": ["provider"]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"provider": {"const": "exofop"}},
                  "required": ["provider"]
                }
              }
            ]
          }
        }
      }
    }
  ]
}
